# 复制为 .env。以下密码仅用于本地演示，部署时自行设置。
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_PASSWORD=local_meta_change_me
# Compose 将此密码同时传入 DB_META_PASSWORD 和 DB_APP_PASSWORD。
# agent_app 连接声明在 conf/app_config.yaml 的 db_app，不与 DW/Meta 混表。
# 初始化脚本要求此密码只包含字母、数字、下划线或连字符。
DW_QUERY_PASSWORD=local_query_change_me

# 填写真实的 OpenAI 兼容模型服务配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/zai-org/GLM-5.1
WEB_PORT=8080
# Kibana 管理界面仅绑定本机，默认 http://localhost:5601。
KIBANA_PORT=5601
TZ=Asia/Shanghai

# 首次启动前用 model-download 服务下载 CPU Embedding 模型。
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=
EMBEDDING_REVISION=main
